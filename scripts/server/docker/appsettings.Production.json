{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "InMemoryCacheOptions": {
    "MaxMemoryMegabytes": 512
  },
  "MessengerCache": {
    "CacheEnabled": true,
    "RepositoryEnabled": true,
    "TimeToLive": "00:01:00",
    "PollInterval": "00:00:10"
  },
  "MessengerInbox": {
    "MaxPollTimeoutSeconds": 30,
    "MessageRetention": "30.00:00:00"
  },
  "Persistence": {
    "Enabled": false,
    "ConnectionString": "Host=host.docker.internal;Port=5432;Database=shortp2p_messenger;Username=shortp2p;Password=CHANGE_ME",
    "ApplyMigrationsOnStartup": true
  },
  "Auth": {
    "Issuer": "ShortP2P.MessengerServer",
    "Audience": "ShortP2P.Clients",
    "SigningKey": "REPLACE_VIA_ENV_OR_ENTRYPOINT",
    "TokenLifetime": "08:00:00",
    "LiteDb": {
      "ConnectionString": "Filename=/var/lib/shortp2p/data/messenger-auth.litedb;Connection=shared"
    }
  },
  "HostPowers": {
    "LiteDb": {
      "ConnectionString": "Filename=/var/lib/shortp2p/data/messenger-host-powers.litedb;Connection=shared"
    }
  },
  "Trust": {
    "SelfHost": "127.0.0.1",
    "SelfPort": 51111,
    "LiteDb": {
      "ConnectionString": "Filename=/var/lib/shortp2p/data/messenger-trust.litedb;Connection=shared"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://0.0.0.0:51111"
      }
    }
  }
}
