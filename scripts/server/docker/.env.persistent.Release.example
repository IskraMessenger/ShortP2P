# Persistent Release stack (Postgres 11 data on host).
HOST_PORT=51111
INTERNAL_PORT=51111
MEMORY_MB=512
CPUS=1
TRUST_SELF_HOST=127.0.0.1

# Host folder for PostgreSQL data (override or pass --persistence-dir).
# Default: $APPUSER/ShortP2P/MessengerServer/persistence
# PERSISTENCE_DIR=

# Host TLS certs folder → container /etc/shortp2p/certs (independent of persistence).
# Default: $APPUSER/ShortP2P/MessengerServer/certs (override or pass --certs-dir).
# CERTS_DIR=

POSTGRES_DB=shortp2p_messenger
# Postgres listen/connect port on the Compose private network (not published to host).
POSTGRES_PORT=5432
# Login/password: asked interactively by run-persistent on first start.
# Empty login → shortp2p; empty password → auto-generated in container (secrets volume only).
# Non-interactive: set POSTGRES_USER / POSTGRES_PASSWORD in the environment before running.
# POSTGRES_USER=shortp2p
# POSTGRES_PASSWORD=

# AUTH_SIGNING_KEY=
SHORTP2P_CERT_PASSWORD=changeit

IMAGE_TAG=latest
COMPOSE_PROJECT_NAME=shortp2p-persistent
