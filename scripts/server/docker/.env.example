# Published (host) port mapped to the container listener.
# Mapping is HOST_PORT:INTERNAL_PORT (example: 8080:51111).
HOST_PORT=51111
INTERNAL_PORT=51111

# Container resource limits (memory MB >= 512, CPU cores >= 1).
MEMORY_MB=512
CPUS=1

# Address clients should use for this node (not 127.0.0.1 on LAN/WAN).
TRUST_SELF_HOST=127.0.0.1

# Optional override. Leave unset to let entrypoint generate and persist a key.
# AUTH_SIGNING_KEY=

# Password for the PFX (mounted or auto-generated self-signed).
SHORTP2P_CERT_PASSWORD=changeit

# Host TLS certs folder → container /etc/shortp2p/certs (override or pass --certs-dir).
# Default: $APPUSER/ShortP2P/MessengerServer/certs (LOCALAPPDATA / XDG_DATA_HOME fallback).
# CERTS_DIR=

IMAGE_TAG=latest
COMPOSE_PROJECT_NAME=shortp2p
