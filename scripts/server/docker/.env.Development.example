# Development stack. Mapping is HOST_PORT:INTERNAL_PORT (example: 8080:51111).
HOST_PORT=51111
INTERNAL_PORT=51111

TRUST_SELF_HOST=127.0.0.1

# Optional override. Leave unset to let entrypoint generate and persist a key.
# AUTH_SIGNING_KEY=

SHORTP2P_CERT_PASSWORD=changeit

IMAGE_TAG=dev
COMPOSE_PROJECT_NAME=shortp2p-dev
